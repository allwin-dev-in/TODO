### ---signup methods--- ###

# api call for adding new user
###
POST http://127.0.0.1:8000/tasks/signup/
Content-Type: application/json

{
    "username":"user",
    "password":"password",
    "email":"user@gmail.com"
}


### TASK ENDPOINTS ###

#Api call for listing tasks
###
GET http://127.0.0.1:8000/tasks/task/
Accept: application/json
Authorization: Basic user:password

#api call for adding new task
###
POST  http://127.0.0.1:8000/tasks/task/
Content-Type: application/json
Authorization: Basic user:password

{
    "title":"swimming",
    "priority":"low",
    "category":"cardio",
    "created_by":1
}

#Api call for Retriving record id=2
###
GET http://127.0.0.1:8000/tasks/task/1/
Accept: application/json
Authorization: Basic user:password

#Api call for updating
###
PUT http://127.0.0.1:8000/tasks/task/1/
Content-Type: application/json
Authorization: Basic user:password

{
  "title": "walking",
  "description": "walking 5 km",
  "priority": "high",
  "category": "cardio",
  "created_at": "2026-10-12T09:42:21.721252Z",
  "updated_at": "2026-10-12T09:42:21.721290Z",
  "created_by": 1
}

#Api call for deleting recoed
###
DELETE http://127.0.0.1:8000/tasks/task/1/
Authorization: Basic user:password
